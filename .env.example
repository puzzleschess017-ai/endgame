# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------------------------
# Payments (Polar, https://polar.sh): e-books at $1.99 and the Premium subscription. All of this is optional:
# until the values are set the Buy button says "Buying opens soon" and the webhook answers 503.
# See server/payments.ts for how it works.
#
# Steps on polar.sh: create an organization, connect the payout account (a bank account in your own country,
# in its own currency), create the products below, add a webhook endpoint, and make an organization access token.
#
# Test first with a Polar SANDBOX account (sandbox.polar.sh): POLAR_SERVER=sandbox and the sandbox ids and secrets.
# ---------------------------------------------------------------------------------------------

# Organization access token with the scope "checkouts:write" (Settings, Developers).
POLAR_ACCESS_TOKEN=""
# "sandbox" for Polar's test environment; leave empty for the real one.
POLAR_SERVER=""

# Webhook: URL  https://<your site>/api/webhooks/polar   Format: Raw   Events: order.paid, order.refunded,
# subscription.created, subscription.active, subscription.updated, subscription.canceled,
# subscription.uncanceled, subscription.revoked, subscription.paused, subscription.resumed
# The secret is the "whsec_..." text Polar shows for the endpoint.
POLAR_WEBHOOK_SECRET=""

# The Supabase SERVICE ROLE key (Project Settings, API Keys). A secret: it can write to any row, so it lives only
# here on the server, never in the page and never in git. The webhook uses it to record purchases and plans.
SUPABASE_SERVICE_ROLE_KEY=""

# Product ids (the UUID on each product's page in Polar). One-time product for each e-book, $1.99:
# the name is POLAR_PRODUCT_EBOOK_ followed by the e-book's slug in capitals, - written as _.
POLAR_PRODUCT_EBOOK_QUEENS_GAMBIT=""
# Premium subscription products (monthly, yearly). Premium has every e-book for free.
POLAR_PRODUCT_PREMIUM_MONTHLY=""
POLAR_PRODUCT_PREMIUM_YEARLY=""

# The public address of the site, used for the page Polar sends the buyer back to (default https://chesstacticsguide.com).
SITE_URL=""
