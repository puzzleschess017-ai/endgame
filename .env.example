# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------------------------
# Payments (Dodo Payments, https://dodopayments.com): e-books at $1.99 and the Premium subscription. All of this is
# optional: until the values are set the Buy buttons say "opens soon" and the webhook answers 503.
# See server/payments.ts for how it works. Dodo is the seller (merchant of record) and handles VAT and sales tax.
#
# Steps in the Dodo dashboard: create the account and the business profile, add the payout account, create the products
# below, add a webhook endpoint, and make an API key. Do all of it first in TEST MODE (the test mode switch in the dashboard):
# test mode has its own API key, products and webhook secret, and a test card pays without real money.
# ---------------------------------------------------------------------------------------------

# API key (Developer, API Keys). A test key starts with dodo_test_, a live key with dodo_live_. A secret: only here, never in git.
DODO_PAYMENTS_API_KEY=""
# "test_mode" for Dodo's test environment, "live_mode" (or empty) for the real one. Empty: decided by the key's prefix.
DODO_PAYMENTS_ENVIRONMENT=""

# Webhook (Developer, Webhooks): URL  https://<your site>/api/webhooks/dodo
# Events to send: payment.succeeded, refund.succeeded, subscription.active, subscription.renewed, subscription.updated,
# subscription.on_hold, subscription.cancelled, subscription.expired, subscription.paused, subscription.plan_changed
# The secret is the "whsec_..." text Dodo shows for the endpoint.
DODO_PAYMENTS_WEBHOOK_KEY=""

# The Supabase SERVICE ROLE key (Project Settings, API Keys). A secret: it can write to any row, so it lives only
# here on the server, never in the page and never in git. The webhook uses it to record purchases and plans.
SUPABASE_SERVICE_ROLE_KEY=""

# Product ids (pdt_... on each product's page in Dodo). One-time product for each e-book, $1.99:
# the name is DODO_PAYMENTS_PRODUCT_EBOOK_ followed by the e-book's slug in capitals, - written as _.
DODO_PAYMENTS_PRODUCT_EBOOK_QUEENS_GAMBIT=""
# Premium subscription products: $4.99 per month and $39.99 per year (the prices on the site are in src/utils/premium.ts).
# Premium has every e-book for free.
DODO_PAYMENTS_PRODUCT_PREMIUM_MONTHLY=""
DODO_PAYMENTS_PRODUCT_PREMIUM_YEARLY=""

# The public address of the site, used for the page Dodo sends the buyer back to (default https://chesstacticsguide.com).
SITE_URL=""
